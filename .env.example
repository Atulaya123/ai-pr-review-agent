# Copy to .env and fill in. Never commit .env — it's gitignored.

# --- Database ---
# Local dev (docker compose): the default below already works. Ports are 5544/6480,
# not the standard 5432/6379 — this avoids clashing with any Postgres/Redis/tunnel
# already running natively on your machine (docker-compose.yml maps the same way).
# Production (M2): paste the Tiger Cloud connection string, converted to the
# asyncpg driver form: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB?ssl=require
TIGER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5544/aipr_review

# --- Queue ---
REDIS_URL=redis://localhost:6480/0

# --- LLM ---
# "mock" (default, no key needed, used by the test suite) | "openai" | "anthropic"
# | "ollama" (free, local, run `ollama serve` + pull a model) | "groq" (free hosted
# API, used by the deployed instance — local Ollama can't run on free hosting).
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- GitHub App (M2) ---
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# Local dev: path to the downloaded .pem file.
GITHUB_PRIVATE_KEY_PATH=secrets/github-app-private-key.pem
# Deployed (Render etc.): paste the full .pem file's contents here instead —
# free hosts have an ephemeral filesystem, so a file path won't survive a
# redeploy. Takes precedence over GITHUB_PRIVATE_KEY_PATH when set.
GITHUB_PRIVATE_KEY=

# --- HITL / economics ---
# 0.93, not a round-number guess like 0.75 — calibrated against real findings
# from live PRs against the deployed model; see backend/core/config.py.
HITL_CONFIDENCE_THRESHOLD=0.93
DAILY_BUDGET_USD=5.0

# --- Observability (optional) ---
# LangSmith traces the LangGraph run itself (per-node latency, tokens, errors) —
# complements agent_events, which is the business-level audit/cost ledger, not a
# replacement for it. Free tier, no card required: smith.langchain.com -> Settings
# -> API Keys. Diff content flows through LangSmith's servers as part of the trace
# when this is on — same untrusted-input consideration as any other LLM call.
# Not LANGSMITH_TRACING — that name collides with the LangSmith SDK's own
# native env var, which self-activates tracing independent of this app's
# config once set, regardless of whether LANGSMITH_API_KEY below is real.
AIPR_LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aipr-review-agent
